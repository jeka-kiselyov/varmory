{
  "name": "varmory",
  "description": "",
  "version": "1.0.3",
  "files": [
    "dist",
    "mcp/showcaseMcp.js",
    "mcp/server.js"
  ],
  "main": "./dist/varmory.umd.js",
  "module": "./dist/varmory.mjs",
  "exports": {
    ".": {
      "import": "./dist/varmory.mjs",
      "require": "./dist/varmory.umd.js"
    },
    "./index.css": "./dist/index.css",
    "./mcp": "./mcp/showcaseMcp.js"
  },
  "scripts": {
    "servedemo": "vite --config demo.vite.config.mjs",
    "builddemo": "NODE_ENV=production vite build --config demo.vite.config.mjs --emptyOutDir",
    "buildcomponent": "NODE_ENV=production vite build --config component.vite.config.mjs",
    "deploymcp": "npm run buildcomponent; npm run builddemo; bash mcp/heroku/deploy.sh varmory",
    "prepublishOnly": "npm run buildcomponent"
  },
  "peerDependencies": {
    "@quasar/extras": "^1.17.0",
    "pinia": "^3.0.4",
    "quasar": "^2.0.0",
    "vue": "^3.0.0"
  },
  "keywords": [
    "vue"
  ],
  "devDependencies": {
    "@quasar/extras": "^1.17.0",
    "@quasar/vite-plugin": "^1.10.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "pinia": "^3.0.4",
    "quasar": "^2.19.2",
    "vite": "^5.4.18",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vue": "^3.5.13"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "babel-eslint"
    },
    "rules": {}
  },
  "dependencies": {
    "@quasar/quasar-ui-qmarkdown": "^2.0.5"
  }
}
